<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000">

    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:keepScreenOn="true"
        app:resize_mode="fit"
        app:surface_type="texture_view"
        app:show_buffering="when_playing"
        app:use_controller="false" />

    <ProgressBar
        android:id="@+id/busy"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center"
        android:indeterminateTint="@color/accent"
        android:visibility="gone" />

    <View
        android:id="@+id/touch"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <TextView
        android:id="@+id/rippleL"
        android:layout_width="170dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@drawable/bg_ripple_l"
        android:drawableTop="@drawable/ic_rew"
        android:drawablePadding="4dp"
        android:gravity="center"
        android:textColor="#FFFFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <TextView
        android:id="@+id/rippleR"
        android:layout_width="170dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:background="@drawable/bg_ripple_r"
        android:drawableTop="@drawable/ic_fwd"
        android:drawablePadding="4dp"
        android:gravity="center"
        android:textColor="#FFFFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/hud"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal|top"
        android:layout_marginTop="90dp"
        android:background="@drawable/bg_hud"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp"
        android:visibility="gone">
        <ImageView
            android:id="@+id/hudIcon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginEnd="10dp"
            android:contentDescription="@null" />
        <TextView
            android:id="@+id/hudText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFeatureSettings="tnum"
            android:textColor="#FFFFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/speedBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal|top"
        android:layout_marginTop="40dp"
        android:background="@drawable/bg_hud"
        android:paddingHorizontal="14dp"
        android:paddingVertical="6dp"
        android:text="2×  ▶▶"
        android:textColor="#FFFFFFFF"
        android:textStyle="bold"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="@drawable/bg_top"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingBottom="28dp">

        <ImageButton android:id="@+id/btnBack" style="@style/PlayerIcon" android:src="@drawable/ic_back" android:contentDescription="Back" />
        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="6dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="#FFFFFFFF"
            android:textSize="17sp"
            android:textStyle="bold" />
        <ImageButton android:id="@+id/btnBg" style="@style/PlayerIcon" android:src="@drawable/ic_headphones" android:contentDescription="Background play" />
        <ImageButton android:id="@+id/btnAudio" style="@style/PlayerIcon" android:src="@drawable/ic_audio" android:contentDescription="Audio track" />
        <ImageButton android:id="@+id/btnSubs" style="@style/PlayerIcon" android:src="@drawable/ic_subtitle" android:contentDescription="Subtitles" />
        <ImageButton android:id="@+id/btnSpeed" style="@style/PlayerIcon" android:src="@drawable/ic_speed" android:contentDescription="Speed" />
        <ImageButton android:id="@+id/btnPip" style="@style/PlayerIcon" android:src="@drawable/ic_pip" android:contentDescription="Pop-up player" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_bottom"
        android:orientation="vertical"
        android:paddingTop="36dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/tvPos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFeatureSettings="tnum"
                android:text="0:00"
                android:textColor="#FFFFFFFF"
                android:textSize="14sp" />
            <SeekBar
                android:id="@+id/seek"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="1000"
                android:paddingVertical="10dp"
                android:progressBackgroundTint="#66FFFFFF"
                android:progressTint="@color/accent"
                android:secondaryProgressTint="#99FFFFFF"
                android:thumbTint="@color/accent" />
            <TextView
                android:id="@+id/tvDur"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFeatureSettings="tnum"
                android:text="0:00"
                android:textColor="#FFFFFFFF"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <ImageButton android:id="@+id/btnLock" style="@style/PlayerIcon" android:src="@drawable/ic_unlock" android:contentDescription="Lock" />
            <ImageButton android:id="@+id/btnRepeat" style="@style/PlayerIcon" android:src="@drawable/ic_repeat" android:contentDescription="Repeat off" />
            <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
            <ImageButton android:id="@+id/btnPrev" style="@style/PlayerIcon" android:src="@drawable/ic_prev" android:contentDescription="Previous" />
            <ImageButton
                android:id="@+id/btnPlay"
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:layout_marginHorizontal="6dp"
                android:background="@drawable/bg_play"
                android:contentDescription="Play"
                android:scaleType="center"
                android:src="@drawable/ic_pause"
                android:tint="@color/accent_ink" />
            <ImageButton android:id="@+id/btnNext" style="@style/PlayerIcon" android:src="@drawable/ic_next" android:contentDescription="Next" />
            <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
            <TextView
                android:id="@+id/btnAspect"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill"
                android:gravity="center"
                android:minWidth="56dp"
                android:paddingHorizontal="8dp"
                android:paddingVertical="6dp"
                android:text="FIT"
                android:textColor="#FFFFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />
            <ImageButton android:id="@+id/btnRotate" style="@style/PlayerIcon" android:src="@drawable/ic_rotate" android:contentDescription="Rotate" />
        </LinearLayout>
    </LinearLayout>

    <ImageButton
        android:id="@+id/btnUnlock"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_gravity="start|center_vertical"
        android:layout_marginStart="24dp"
        android:background="@drawable/bg_round"
        android:contentDescription="Unlock"
        android:src="@drawable/ic_lock"
        android:tint="#FFFFFFFF"
        android:visibility="gone" />

    <TextView
        android:id="@+id/resumeChip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="140dp"
        android:background="@drawable/bg_chip"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp"
        android:textColor="@color/fg"
        android:visibility="gone" />
</FrameLayout>
