1 ICON "../icon.ico"
1 24 "tezdm.manifest"
1 VERSIONINFO
FILEVERSION @VERSIONC@,0
PRODUCTVERSION @VERSIONC@,0
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "TezDM"
      VALUE "FileDescription", "TezDM - Fast Download Manager"
      VALUE "FileVersion", "@VERSION@"
      VALUE "ProductName", "TezDM"
      VALUE "ProductVersion", "@VERSION@"
      VALUE "OriginalFilename", "TezDM.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
